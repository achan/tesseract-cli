#!/usr/bin/env bash
set -euo pipefail

APP_ID="${TESSERACT_APP_ID:-tesseract-web}"
APP_SHORTHAND="${TESSERACT_APP_SHORTHAND:-$APP_ID}"
MAIN_PATH="${TESSERACT_MAIN_PATH:?missing TESSERACT_MAIN_PATH}"
WORKTREE_ROOT="${TESSERACT_WORKTREE_ROOT:?missing TESSERACT_WORKTREE_ROOT}"
DOMAIN="${TESSERACT_DOMAIN:?missing TESSERACT_DOMAIN}"
CERT_PATH="${TESSERACT_CERT_PATH:?missing TESSERACT_CERT_PATH}"
KEY_PATH="${TESSERACT_KEY_PATH:?missing TESSERACT_KEY_PATH}"
AGENT_COMMAND="${TESSERACT_AGENT_COMMAND:-codex --yolo}"
AGENT_NAME="${TESSERACT_AGENT_NAME:-codex}"
HERDR_SESSION_NAME="${TESSERACT_HERDR_SESSION:-default}"

usage() {
  cat >&2 <<USAGE
Usage:
  tesseract worktree create ${APP_ID} <slug> [branch]
  tesseract worktree start ${APP_ID} <slug>
  tesseract worktree stop ${APP_ID} <slug>
  tesseract worktree status ${APP_ID} <slug>
  tesseract worktree remove ${APP_ID} <slug> [--force]
USAGE
  exit 1
}

validate_slug() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*)
      echo "invalid worktree slug: $1" >&2
      exit 1
      ;;
  esac
}

sanitize_slug() {
  printf "%s" "$1" | tr '-' '_' | tr -cd '[:alnum:]_'
}

worktree_path() {
  printf "%s/%s" "$WORKTREE_ROOT" "$1"
}

legacy_session_name() {
  printf "tesseract_web_%s" "$(sanitize_slug "$1")"
}

workspace_identity() {
  printf "%s/%s" "$APP_SHORTHAND" "$1"
}

legacy_workspace_label() {
  printf "%s/%s" "$APP_ID" "$1"
}

runtime_spec() {
  path="$1"
  if [ -f "$path/.ruby-version" ]; then
    version=$(cat "$path/.ruby-version")
    printf "ruby@%s" "${version#ruby-}"
  fi
}

run_runtime() {
  path="$1"
  shift
  specs=$(runtime_spec "$path")
  if [ -n "$specs" ] && command -v mise >/dev/null 2>&1; then
    (cd "$path" && mise exec "$specs" -- "$@")
  else
    (cd "$path" && "$@")
  fi
}

runtime_prefix() {
  path="$1"
  specs=$(runtime_spec "$path")
  if [ -n "$specs" ] && command -v mise >/dev/null 2>&1; then
    printf "mise exec %s -- " "$specs"
  fi
}

repository_command() {
  if [ ! -x "$MAIN_PATH/bin/tesseract" ]; then
    echo "missing repo-local $MAIN_PATH/bin/tesseract" >&2
    exit 1
  fi
  (cd "$MAIN_PATH" && "$MAIN_PATH/bin/tesseract" "$@")
}

port_for_slug() {
  env_file="$(worktree_path "$1")/.env.development.local"
  if [ ! -f "$env_file" ]; then
    echo "missing .env.development.local for $1" >&2
    exit 1
  fi
  port=$(sed -n 's/^PORT=//p' "$env_file" | head -1 | tr -d '"' | tr -d "'")
  case "$port" in
    ""|*[!0-9]*)
      echo "invalid PORT in $env_file" >&2
      exit 1
      ;;
  esac
  printf "%s" "$port"
}

ensure_startable() {
  path="$1"
  if [ ! -r "$CERT_PATH" ] || [ ! -r "$KEY_PATH" ]; then
    echo "missing Tesseract web certificate files:" >&2
    echo "  cert: $CERT_PATH" >&2
    echo "  key:  $KEY_PATH" >&2
    exit 1
  fi
  run_runtime "$path" bundle check
}

herdr_command() {
  HERDR_SESSION="$HERDR_SESSION_NAME" herdr "$@"
}

load_workspace() {
  slug="$1"
  identity=$(workspace_identity "$slug")
  legacy_label=$(legacy_workspace_label "$slug")
  workspace_json=$(herdr_command workspace list)
  WORKSPACE_COUNT=$(printf "%s" "$workspace_json" |
    jq -r --arg identity "$identity" --arg legacy "$legacy_label" \
      '[.result.workspaces[] | select(
        .label == $legacy or
        .label == $identity or
        (.label | startswith($identity + "\n"))
      )] | length')
  if [ "$WORKSPACE_COUNT" -gt 1 ]; then
    echo "multiple Herdr workspaces found for $identity" >&2
    exit 1
  fi
  WORKSPACE_ID=$(printf "%s" "$workspace_json" |
    jq -r --arg identity "$identity" --arg legacy "$legacy_label" \
      '.result.workspaces[] | select(
        .label == $legacy or
        .label == $identity or
        (.label | startswith($identity + "\n"))
      ) | .workspace_id')
  WORKSPACE_LABEL=$(printf "%s" "$workspace_json" |
    jq -r --arg identity "$identity" --arg legacy "$legacy_label" \
      '.result.workspaces[] | select(
        .label == $legacy or
        .label == $identity or
        (.label | startswith($identity + "\n"))
      ) | .label')
}

verify_workspace_path() {
  workspace_id="$1"
  path="$2"
  panes_json=$(herdr_command pane list --workspace "$workspace_id")
  pane_count=$(printf "%s" "$panes_json" | jq -r '.result.panes | length')
  mismatch_count=$(printf "%s" "$panes_json" |
    jq -r --arg path "$path" '[.result.panes[] | select(.cwd != $path)] | length')
  if [ "$pane_count" -eq 0 ] || [ "$mismatch_count" -ne 0 ]; then
    echo "Herdr workspace $workspace_id is not rooted at $path" >&2
    exit 1
  fi
}

refresh_workspace_metadata() {
  workspace_id="$1"
  url="$2"
  panes_json=$(herdr_command pane list --workspace "$workspace_id")
  printf "%s" "$panes_json" | jq -r '.result.panes[].pane_id' |
    while IFS= read -r pane_id; do
      herdr_command pane report-metadata "$pane_id" \
        --source tesseract --token "url=$url" >/dev/null
    done
  printf "%s" "$panes_json" | jq -r '.result.panes[] | select(.agent != null) | .pane_id' |
    while IFS= read -r pane_id; do
      herdr_command pane report-metadata "$pane_id" \
        --source tesseract --display-agent "$AGENT_NAME" >/dev/null
    done
}

emit_herdr_runtime() {
  slug="$1"
  path="$2"
  port="$3"
  workspace_id="$4"
  identity=$(workspace_identity "$slug")
  echo "path=$path"
  echo "port=$port"
  echo "url=https://${DOMAIN}:${port}"
  echo "running=yes"
  echo "runtime=herdr"
  echo "session=$HERDR_SESSION_NAME"
  echo "workspace_id=$workspace_id"
  echo "target=${HERDR_SESSION_NAME}:${identity}"
}

rollback_workspace() {
  code=$?
  trap - EXIT
  if [ "$code" -ne 0 ]; then
    workspace_id="${CREATED_WORKSPACE_ID:-}"
    [ -z "$workspace_id" ] || herdr_command workspace close "$workspace_id" >/dev/null 2>&1 || true
  fi
  exit "$code"
}

start_worktree() {
  slug="$1"
  path=$(worktree_path "$slug")
  if [ ! -d "$path" ] || ! git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "worktree is missing: $path" >&2
    exit 1
  fi

  legacy_session=$(legacy_session_name "$slug")
  identity=$(workspace_identity "$slug")
  load_workspace "$slug"
  if [ "$WORKSPACE_COUNT" -eq 1 ] && tmux has-session -t "=$legacy_session" 2>/dev/null; then
    echo "both Herdr and legacy tmux runtimes exist for ${APP_ID}/${slug}" >&2
    exit 1
  fi
  if tmux has-session -t "=$legacy_session" 2>/dev/null; then
    echo "legacy tmux session is still running: $legacy_session; stop it before starting Herdr" >&2
    exit 1
  fi

  port=$(port_for_slug "$slug")
  url="https://${DOMAIN}:${port}"
  if [ "$WORKSPACE_COUNT" -eq 1 ]; then
    verify_workspace_path "$WORKSPACE_ID" "$path"
    if [ "$WORKSPACE_LABEL" != "$identity" ]; then
      herdr_command workspace rename "$WORKSPACE_ID" "$identity" >/dev/null
    fi
    refresh_workspace_metadata "$WORKSPACE_ID" "$url"
    echo "workspace already running: $identity"
    emit_herdr_runtime "$slug" "$path" "$port" "$WORKSPACE_ID"
    return
  fi

  ensure_startable "$path"
  prefix=$(runtime_prefix "$path")
  printf -v rails_command \
    'PORT=%q ALLOWED_HOSTS=%q %sbin/rails server -p %q -b %q' \
    "$port" "$DOMAIN" "$prefix" "$port" \
    "ssl://0.0.0.0?key=${KEY_PATH}&cert=${CERT_PATH}"
  printf -v jobs_command '%sbin/jobs' "$prefix"
  printf -v tailwind_command '%sbin/rails tailwindcss:watch' "$prefix"
  printf -v agent_command 'TESSERACT_LIVE_ACTIVITY_APP=%q %s' "$APP_ID" "$AGENT_COMMAND"

  CREATED_WORKSPACE_ID=""
  trap rollback_workspace EXIT
  workspace_create_json=$(herdr_command workspace create \
    --cwd "$path" --label "$identity" \
    --env "TESSERACT_LIVE_ACTIVITY_APP=$APP_ID" --no-focus)
  CREATED_WORKSPACE_ID=$(printf "%s" "$workspace_create_json" | jq -er '.result.workspace.workspace_id')
  code_tab_id=$(printf "%s" "$workspace_create_json" | jq -er '.result.tab.tab_id')
  codex_pane_id=$(printf "%s" "$workspace_create_json" | jq -er '.result.root_pane.pane_id')
  herdr_command tab rename "$code_tab_id" Code >/dev/null
  terminal_json=$(herdr_command pane split \
    --pane "$codex_pane_id" --direction right --ratio 0.5 --cwd "$path" \
    --env "TESSERACT_LIVE_ACTIVITY_APP=$APP_ID" --no-focus)
  terminal_pane_id=$(printf "%s" "$terminal_json" | jq -er '.result.pane.pane_id')
  herdr_command pane rename "$codex_pane_id" Codex >/dev/null
  herdr_command pane rename "$terminal_pane_id" Terminal >/dev/null

  servers_json=$(herdr_command tab create \
    --workspace "$CREATED_WORKSPACE_ID" --cwd "$path" --label Servers \
    --env "TESSERACT_LIVE_ACTIVITY_APP=$APP_ID" --no-focus)
  rails_pane_id=$(printf "%s" "$servers_json" | jq -er '.result.root_pane.pane_id')
  jobs_json=$(herdr_command pane split \
    --pane "$rails_pane_id" --direction down --ratio 0.67 --cwd "$path" --no-focus)
  jobs_pane_id=$(printf "%s" "$jobs_json" | jq -er '.result.pane.pane_id')
  tailwind_json=$(herdr_command pane split \
    --pane "$jobs_pane_id" --direction right --ratio 0.5 --cwd "$path" --no-focus)
  tailwind_pane_id=$(printf "%s" "$tailwind_json" | jq -er '.result.pane.pane_id')
  herdr_command pane rename "$rails_pane_id" Rails >/dev/null
  herdr_command pane rename "$jobs_pane_id" Jobs >/dev/null
  herdr_command pane rename "$tailwind_pane_id" Tailwind >/dev/null

  herdr_command pane run "$codex_pane_id" "$agent_command" >/dev/null
  herdr_command pane run "$rails_pane_id" "$rails_command" >/dev/null
  herdr_command pane run "$jobs_pane_id" "$jobs_command" >/dev/null
  herdr_command pane run "$tailwind_pane_id" "$tailwind_command" >/dev/null
  for pane_id in "$codex_pane_id" "$terminal_pane_id" "$rails_pane_id" "$jobs_pane_id" "$tailwind_pane_id"; do
    if [ "$pane_id" = "$codex_pane_id" ]; then
      herdr_command pane report-metadata "$pane_id" --source tesseract \
        --display-agent "$AGENT_NAME" --token "url=$url" >/dev/null
    else
      herdr_command pane report-metadata "$pane_id" --source tesseract \
        --token "url=$url" >/dev/null
    fi
  done
  trap - EXIT

  echo "started $identity"
  emit_herdr_runtime "$slug" "$path" "$port" "$CREATED_WORKSPACE_ID"
}

stop_worktree() {
  slug="$1"
  identity=$(workspace_identity "$slug")
  legacy_session=$(legacy_session_name "$slug")
  stopped=false
  load_workspace "$slug"
  if [ "$WORKSPACE_COUNT" -eq 1 ]; then
    herdr_command workspace close "$WORKSPACE_ID" >/dev/null
    echo "stopped $identity"
    stopped=true
  fi
  if tmux has-session -t "=$legacy_session" 2>/dev/null; then
    tmux kill-session -t "=$legacy_session"
    echo "stopped legacy tmux session $legacy_session"
    stopped=true
  fi
  if [ "$stopped" = false ]; then
    echo "not running: $identity"
  fi
}

status_worktree() {
  slug="$1"
  path=$(worktree_path "$slug")
  identity=$(workspace_identity "$slug")
  legacy_session=$(legacy_session_name "$slug")

  echo "app=$APP_ID"
  echo "slug=$slug"
  echo "path=$path"
  if [ -d "$path" ] && git -C "$path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "registered=yes"
    echo "branch=$(git -C "$path" branch --show-current)"
    port=$(port_for_slug "$slug")
    echo "port=$port"
    echo "url=https://${DOMAIN}:${port}"
  else
    echo "registered=no"
    echo "url=-"
  fi

  load_workspace "$slug"
  legacy_running=false
  tmux has-session -t "=$legacy_session" 2>/dev/null && legacy_running=true
  if [ "$WORKSPACE_COUNT" -eq 1 ] && [ "$legacy_running" = true ]; then
    echo "both Herdr and legacy tmux runtimes exist for ${APP_ID}/${slug}" >&2
    exit 1
  fi
  if [ "$WORKSPACE_COUNT" -eq 1 ]; then
    verify_workspace_path "$WORKSPACE_ID" "$path"
    echo "running=yes"
    echo "runtime=herdr"
    echo "session=$HERDR_SESSION_NAME"
    echo "workspace_id=$WORKSPACE_ID"
    echo "target=${HERDR_SESSION_NAME}:${identity}"
  elif [ "$legacy_running" = true ]; then
    echo "running=yes"
    echo "runtime=tmux"
    echo "tmux_session=$legacy_session"
    echo "target=$legacy_session"
    echo "legacy_runtime=yes"
  else
    echo "running=no"
    echo "runtime=none"
    echo "target=-"
  fi
}

remove_worktree() {
  slug="$1"
  force="${2:-}"
  stop_worktree "$slug"
  if [ "$force" = "--force" ]; then
    repository_command worktree remove "$slug" --force
  else
    repository_command worktree remove "$slug"
  fi
}

[ "${1:-}" = "worktree" ] || usage
action="${2:-}"
shift 2 || usage
slug="${1:-}"
validate_slug "$slug"

case "$action" in
  create) repository_command worktree create "$@" ;;
  start) [ "$#" -eq 1 ] || usage; start_worktree "$slug" ;;
  stop) [ "$#" -eq 1 ] || usage; stop_worktree "$slug" ;;
  status) [ "$#" -eq 1 ] || usage; status_worktree "$slug" ;;
  remove) [ "$#" -le 2 ] || usage; remove_worktree "$@" ;;
  *) usage ;;
esac
